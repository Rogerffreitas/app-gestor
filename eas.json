{
    "cli": {
        "version": ">= 16.32.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "autoIncrement": true
        },
        "preview": {
            "distribution": "internal",
            "autoIncrement": true,

            "env": {
                "EXPO_PUBLIC_URL_API": "http://164.152.34.165:3000/api/v1",
                "EXPO_PUBLIC_URL_LOGIN": "/auth/signin",
                "EXPO_PUBLIC_KEY_SECURE_STORE_USER": "gestor-user",
                "EXPO_PUBLIC_KEY_SECURE_STORE_ENTERPRISE": "gestor-enterprise",
                "EXPO_PUBLIC_KEY_SECURE_STORE_TOKEN": "gestor-token"
            }
        },
        "production": {
            "autoIncrement": true
        }
    },
    "submit": {
        "production": {}
    }
}
